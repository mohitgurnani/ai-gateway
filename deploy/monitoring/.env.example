# AI Gateway monitoring stack - environment template.
# Copy to ".env" on the host (10.113.24.33) before `docker compose up -d`.
# Never commit a real ".env" - secrets are bind-mounted from a separate
# secrets/ directory (see Slack section below).

# Langfuse Basic-auth header (base64 of "<public_key>:<secret_key>"). Used
# only by the otel-collector's otlphttp/langfuse exporter when the gateways
# route through this collector (post-P3d cutover).
LANGFUSE_AUTH_B64=replace-me-with-base64-of-pk:sk

# Grafana admin user. Anonymous viewers are enabled by default (see
# docker-compose.yml grafana env vars).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=replace-me

# Slack delivery (P4)
# ------------------
# We page #panacea-mcp-monitoring via a Slack Incoming Webhook, NOT a bot
# token. Alertmanager reads the URL from a file:
#   ./alertmanager/secrets/slack_webhook_url    (chmod 644, owner: nutanix)
# referenced by alertmanager.yml's `global.slack_api_url_file`. The file
# itself is intentionally outside source control (.gitignore covers it).
#
# To wire the webhook on a fresh host:
#   mkdir -p alertmanager/secrets
#   echo "https://hooks.slack.com/services/XXX/YYY/ZZZ" \
#       > alertmanager/secrets/slack_webhook_url
#   chmod 644 alertmanager/secrets/slack_webhook_url
#
# Nothing in this .env file is needed for Slack delivery anymore. The old
# SLACK_BOT_TOKEN / SLACK_CHANNEL pair (used by the deprecated slack-relay)
# is intentionally absent.
