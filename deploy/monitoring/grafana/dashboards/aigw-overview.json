      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "MCP Probe Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
